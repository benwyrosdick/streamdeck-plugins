{
    "name": "streamdeck-tailscale",
    "version": "1.0.0",
    "private": true,
    "description": "Control Tailscale from your Stream Deck.",
    "license": "MIT",
    "author": "Ben Wyrosdick",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.benwyrosdick.tailscale\"",
        "typecheck": "tsc --noEmit",
        "images": "node scripts/generate-images.ts",
        "test": "vitest run",
        "validate": "streamdeck validate com.benwyrosdick.tailscale.sdPlugin",
        "pack": "npm run build && streamdeck pack com.benwyrosdick.tailscale.sdPlugin --output dist --force"
    },
    "type": "module",
    "devDependencies": {
        "@elgato/cli": "^1.10.4",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node20": "^20.1.2",
        "@types/node": "~24.1.0",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "typescript": "^5.2.2",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@elgato/streamdeck": "^3.0.4",
        "@elgato/utils": "^0.6.2"
    }
}
